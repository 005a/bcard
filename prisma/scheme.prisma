generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// 1. Профиль:
// - имя;
// - краткое описание;
// - ссылки на GitHub/LinkedIn или другие профессиональные ресурсы.

// 2. Список навыков.

// 3. Опыт работы:
// - компания;
