model UserProfile {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  created_at    DateTime @default(now())
  User          User[]
}


enum SocialLinkType {
  GITHUB
  LINKEDIN
}

model SocialLinkModel {
  id                    Int      @id @default(autoincrement())
  url                   String   @unique  // that will help for duplicates
  created_at            DateTime @default(now())
  social_link_type      SocialLinkType[]
}

model User {
  id            Int                 @id @default(autoincrement())
  name          String          
  email         String              @unique
  password      String          
  created_at    DateTime            @default(now())
  Role          Role                @relation(fields: [role_id], references: [id])
  description   String?   
  social_links  SocialLinkModel[]   
}